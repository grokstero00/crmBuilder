# Входящий вебхук портала: Битрикс24 → Разработчикам → Другое → Входящий вебхук.
# Нужны права: crm и department (структура компании).
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# Язык, на котором Битрикс отдаёт подписи пользовательских полей.
BITRIX_LANG=ru

# uid/gid пользователя хоста (`id -u`, `id -g`), чтобы файлы в ./workspace
# принадлежали вам, а не контейнеру. По умолчанию 1000.
HOST_UID=1000
HOST_GID=1000
