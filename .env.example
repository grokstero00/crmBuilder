# ── Ссылка на портал ─────────────────────────────────────────────────────────
# Где взять: Битрикс24 → Приложения → Разработчикам → Другое → Входящий вебхук.
# Права вебхука: CRM (crm) и Структура компании (department).
# Вставьте ссылку из поля «Вебхук для вызова rest api» целиком, без кавычек
# и пробелов вокруг «=». Формат: https://<портал>/rest/<ID пользователя>/<ключ>/
# Ссылка работает как пароль: этот файл не попадает в git, никому его не отправляйте.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# ── Разрешение на запись ─────────────────────────────────────────────────────
# Без этой строки `apply` и `rollback` откажутся менять портал (import и plan
# работают всегда, они только читают). Включайте только для тестовых порталов
# и тех, которые вам разрешено менять. Для рабочих порталов клиентов не трогайте.
# BITRIX_ALLOW_WRITE=yes

# ── Дополнительный доверенный сертификат (только при ошибке SSL) ───────────────
# Если импорт падает с CERTIFICATE_VERIFY_FAILED: сохраните корневой сертификат
# антивируса / корпоративного прокси / национального УЦ в workspace/ca.pem
# и раскомментируйте строку. Путь указывается внутри контейнера.
# BITRIX_CA_BUNDLE=/workspace/ca.pem

# ── ИИ-проектировщик (команда design) ────────────────────────────────────────
# Ключ API: console.anthropic.com → API keys. Это секрет, как и вебхук.
# В Claude уходит только структура портала, без сделок и контактов.
# ANTHROPIC_API_KEY=sk-ant-...
# Модель и глубина размышления (по умолчанию claude-opus-5-5 и high).
# Дешевле вдвое: CRMBUILDER_MODEL=claude-sonnet-5-5
# CRMBUILDER_MODEL=claude-opus-5-5
# CRMBUILDER_EFFORT=high

# ── Язык подписей полей ──────────────────────────────────────────────────────
BITRIX_LANG=ru

# ── Веб-интерфейс (docker compose up) ────────────────────────────────────────
# Секретный ключ сервера: подписывает входы и шифрует вебхуки в базе.
# Сгенерируйте в Git Bash: openssl rand -hex 32  — и вставьте результат.
# Если ключ потерять или сменить, сохранённые вебхуки придётся ввести заново.
CRMBUILDER_SECRET_KEY=
# Пароль базы данных (база доступна только внутри Docker).
POSTGRES_PASSWORD=crmbuilder
# Регистрация новых пользователей: no — только уже зарегистрированные.
# CRMBUILDER_ALLOW_SIGNUP=yes

# ── Владелец файлов в ./workspace ────────────────────────────────────────────
# Linux: подставьте вывод команд `id -u` и `id -g`.
# Windows и macOS (Docker Desktop): оставьте 1000.
HOST_UID=1000
HOST_GID=1000
